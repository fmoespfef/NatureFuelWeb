    <script>
        let cart = [];

        // ENHANCED FIXED MESSAGE NOTIFICATION SYSTEM (STACKS VERTICALLY, SLIDES SMOOTHLY)
        function showNotification(message) {
            const container = document.getElementById('notification-container');
            const toast = document.createElement('div');
            
            toast.className = "bg-brandDark text-white text-sm font-bold px-5 py-3.5 rounded-2xl shadow-xl transition-all duration-300 transform translate-x-12 opacity-0 flex items-center space-x-3 pointer-events-auto border border-white/10";
            toast.innerHTML = `
                <span class="text-brandYellow flex-shrink-0">✨</span>
                <span class="flex-1">${message}</span>
            `;
            
            container.appendChild(toast);
            
            requestAnimationFrame(() => {
                toast.classList.remove('translate-x-12', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('translate-x-12', 'opacity-0');
                setTimeout(() => { toast.remove(); }, 300);
            }, 3000);
        }

        function toggleCart() {
            document.getElementById('cart-drawer').classList.toggle('translate-x-full');
        }

        function addToCart(name, price, icon) {
            const existing = cart.find(i => i.name === name);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ name, price, icon, qty: 1 });
            }
            updateCartUI();
            showNotification(`${name} successfully added to bag!`);
        }

        function adjustQty(name, amount) {
            const item = cart.find(i => i.name === name);
            if (item) {
                item.qty += amount;
                if (item.qty <= 0) cart = cart.filter(i => i.name !== name);
            }
            updateCartUI();
        }

        function updateCartUI() {
            const container = document.getElementById('cart-items');
            const emptyMsg = document.getElementById('empty-cart-msg');
            const countBadge = document.getElementById('cart-count');
            const subtotalEl = document.getElementById('cart-subtotal');
            const shippingEl = document.getElementById('cart-shipping');
            const totalEl = document.getElementById('cart-total');
            const checkoutBtn = document.getElementById('checkout-btn');

            const totalItems = cart.reduce((acc, i) => acc + i.qty, 0);
            const subtotal = cart.reduce((acc, i) => acc + (i.price * i.qty), 0);
            const shipping = subtotal > 0 ? 4.99 : 0;
            const finalTotal = subtotal + shipping;

            countBadge.innerText = totalItems;
            subtotalEl.innerText = `$${subtotal.toFixed(2)}`;
            shippingEl.innerText = `$${shipping.toFixed(2)}`;
            totalEl.innerText = `$${finalTotal.toFixed(2)}`;

            container.querySelectorAll('.cart-row').forEach(el => el.remove());

            if (cart.length === 0) {
                emptyMsg.classList.remove('hidden');
                checkoutBtn.disabled = true;
                checkoutBtn.className = "w-full bg-gray-200 text-gray-400 font-bold py-4 rounded-2xl shadow-none text-center block cursor-not-allowed";
                return;
            }

            emptyMsg.classList.add('hidden');
            checkoutBtn.disabled = false;
            checkoutBtn.className = "w-full bg-brandPink hover:opacity-90 text-white font-bold py-4 rounded-2xl shadow-lg text-center block cursor-pointer transition-all active:scale-95";

            cart.forEach(item => {
                const row = document.createElement('div');
                row.className = 'cart-row flex items-center justify-between p-3 bg-white border border-gray-100 rounded-2xl shadow-sm';
                row.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <div class="w-12 h-12 rounded-xl bg-brandBg flex items-center justify-center text-2xl border border-gray-100">${item.icon}</div>
                        <div>
                            <h4 class="font-bold text-sm text-brandDark">${item.name}</h4>
                            <p class="text-xs text-brandGray">$${item.price.toFixed(2)}</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2 bg-brandBg rounded-xl px-2.5 py-1 border border-gray-100">
                        <button onclick="adjustQty('${item.name}', -1)" class="font-bold text-brandGray hover:text-brandPink px-1">-</button>
                        <span class="text-xs font-bold text-brandDark w-4 text-center">${item.qty}</span>
                        <button onclick="adjustQty('${item.name}', 1)" class="font-bold text-brandGray hover:text-brandPink px-1">+</button>
                    </div>
                `;
                container.appendChild(row);
            });
        }

        function openCheckout() {
            toggleCart();
            const modal = document.getElementById('checkout-modal');
            const summaryContainer = document.getElementById('checkout-summary-items');
            
            modal.classList.remove('hidden');
            summaryContainer.innerHTML = '';

            const subtotal = cart.reduce((acc, i) => acc + (i.price * i.qty), 0);
            const shipping = 4.99;
            const finalTotal = subtotal + shipping;

            document.getElementById('summary-subtotal').innerText = `$${subtotal.toFixed(2)}`;
            document.getElementById('summary-shipping').innerText = `$${shipping.toFixed(2)}`;
            document.getElementById('summary-total').innerText = `$${finalTotal.toFixed(2)}`;

            cart.forEach(item => {
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between py-2';
                row.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-lg bg-brandBg flex items-center justify-center text-xl border border-gray-100">${item.icon}</div>
                        <div>
                            <p class="text-sm font-bold text-brandDark">${item.name} <span class="text-xs text-brandGray">x${item.qty}</span></p>
                        </div>
                    </div>
                    <span class="text-sm font-bold text-brandDark">$${(item.price * item.qty).toFixed(2)}</span>
                `;
                summaryContainer.appendChild(row);
            });
        }

        function closeCheckout() { document.getElementById('checkout-modal').classList.add('hidden'); }
        function processOrder(e) { e.preventDefault(); document.getElementById('checkout-modal').classList.add('hidden'); document.getElementById('success-screen').classList.remove('hidden'); }
        function resetStore() { cart = []; updateCartUI(); document.getElementById('checkout-form').reset(); document.getElementById('success-screen').classList.add('hidden'); window.scrollTo({ top: 0, behavior: 'smooth' }); }
    </script>
</body>
</html>
